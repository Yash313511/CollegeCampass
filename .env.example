# Environment Variables for CollegeCompass
# Copy this file to .env and fill in values

# ─── Database ─────────────────────────────────────────────────────
# Neon PostgreSQL connection (pooled)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# Neon PostgreSQL direct connection (for migrations)
DIRECT_DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ─── Authentication ───────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"

# ─── Application ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Chatbot Service Integration ────────────────────────────────
CHATBOT_SERVICE_URL="http://localhost:8000"
CHATBOT_SERVICE_TOKEN="change-me-to-a-random-secret"
NEXT_PUBLIC_CHATBOT_ENABLED="true"

# Legacy fallback webhook (optional)
NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL="https://your-n8n-instance.app.n8n.cloud/webhook/college-compass-chat"

