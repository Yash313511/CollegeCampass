# Environment Variables for CollegeCompass
# Copy this file to .env and fill in values

# ─── Database ─────────────────────────────────────────────────────
# Neon PostgreSQL connection (pooled)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# Neon PostgreSQL direct connection (for migrations)
DIRECT_DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ─── Authentication ───────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"

# ─── Application ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Chatbot (n8n Webhook) ────────────────────────────────────────
# Your n8n webhook URL for the chatbot AI assistant
NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL="https://your-n8n-instance.app.n8n.cloud/webhook/college-compass-chat"
