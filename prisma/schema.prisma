// Prisma schema for CollegeCompass
// PostgreSQL on Neon

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  hashedPassword String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  reviews        Review[]
  savedColleges  SavedCollege[]
  capPreferences CapPreferenceList[]
}

// ─── Core ────────────────────────────────────────────────────────

enum CollegeType {
  GOVERNMENT
  PRIVATE
  DEEMED
  AUTONOMOUS
}

model College {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String
  city            String
  state           String
  type            CollegeType
  establishedYear Int
  affiliation     String
  website         String?
  accreditation   String?

  // Metrics
  rating          Float       @default(0)
  reviewCount     Int         @default(0)

  // Fees (annual, in INR)
  feesMin         Int
  feesMax         Int

  // Placements (in LPA)
  avgPackage      Float?
  highestPackage  Float?
  placementRate   Int?        // percentage 0-100

  // Media
  logoUrl         String?
  imageUrl        String?

  // Relations
  courses         Course[]
  reviews         Review[]
  savedBy         SavedCollege[]
  cutoffs         CutoffData[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([state])
  @@index([city])
  @@index([type])
  @@index([rating])
  @@index([avgPackage])
  @@index([feesMin])
  @@index([feesMax])
}

model Course {
  id          String  @id @default(cuid())
  name        String
  slug        String
  duration    String  // e.g. "4 Years"
  stream      String  // Engineering, Management, Medical, etc.
  fees        Int     // per year in INR
  eligibility String?

  collegeId   String
  college     College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([stream])
  @@index([collegeId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  title     String
  comment   String
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([collegeId])
  @@index([userId])
}

model SavedCollege {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  collegeId String
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, collegeId])
  @@index([userId])
}

// ─── Predictor ───────────────────────────────────────────────────

model CutoffData {
  id          String  @id @default(cuid())
  exam        String  // JEE Main, MHT-CET, KCET, etc.
  category    String  // General, OBC, SC, ST, EWS
  course      String  // Course name
  closingRank Int     // Last admitted rank
  year        Int     // Admission year

  collegeId   String
  college     College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([exam, category])
  @@index([collegeId])
  @@index([closingRank])
}

// ─── Scholarships ────────────────────────────────────────────────

enum ScholarshipType {
  MERIT
  NEED_BASED
  MINORITY
  SPORTS
  RESEARCH
}

enum ScholarshipLevel {
  NATIONAL
  STATE
  INSTITUTIONAL
  PRIVATE
}

model Scholarship {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  provider        String           // e.g. "Government of India", "Tata Trust"
  description     String
  type            ScholarshipType
  level           ScholarshipLevel
  amount          String           // e.g. "₹50,000/year", "Full Tuition"
  eligibility     String           // Who can apply
  deadline        String?          // e.g. "31st October", "Rolling"
  applicationLink String?          // URL to apply
  streams         String[]         // Engineering, Medical, Management, etc.
  categories      String[]         // General, OBC, SC, ST, EWS

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([type])
  @@index([level])
}

// ─── Maharashtra CAP Round ──────────────────────────────────────

model CapCollege {
  id              String      @id @default(cuid())
  collegeCode     String      @unique // 4-digit DTE Code, e.g. "6006", "6271"
  name            String
  slug            String      @unique
  status          String      // e.g. "Government Autonomous", "Unaided Autonomous", "Unaided Private"
  region          String      @default("Pune")
  district        String      @default("Pune")
  university      String      // e.g. "Savitribai Phule Pune University"
  address         String
  establishedYear Int
  website         String?
  feesAnnual      Int         // Approx annual fees in INR
  avgPackage      Float?      // in LPA
  highestPackage  Float?      // in LPA
  rating          Float       @default(4.0)
  accreditation   String?     // e.g. "NAAC A++", "NBA Accredited"
  imageUrl        String?

  courses         CapCourse[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([collegeCode])
  @@index([region])
  @@index([status])
}

model CapCourse {
  id           String      @id @default(cuid())
  choiceCode   String      @unique // 9-digit Choice Code e.g. "600624510"
  courseName   String      // e.g. "Computer Engineering"
  stream       String      @default("Engineering")
  intake       Int         @default(60)
  shift        String      @default("First Shift")
  status       String      @default("Autonomous")

  capCollegeId String
  capCollege   CapCollege  @relation(fields: [capCollegeId], references: [id], onDelete: Cascade)

  cutoffs      CapCutoff[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([choiceCode])
  @@index([capCollegeId])
  @@index([courseName])
}

model CapCutoff {
  id                                String    @id @default(cuid())
  category                          String    // GOPEN, LOPEN, GOBC, LOBC, GSC, LSC, GST, LST, GVJ, GNT1, GNT2, GNT3, EWS, TFWS, AI
  homeUniversityPercentile          Float?    // HU Cutoff Percentile
  homeUniversityRank                Int?      // HU Cutoff Rank
  otherThanHomeUniversityPercentile Float?    // OHU Cutoff Percentile
  otherThanHomeUniversityRank       Int?      // OHU Cutoff Rank
  stateLevelPercentile              Float?    // State Level / All India Cutoff Percentile
  stateLevelRank                    Int?      // State Level / All India Cutoff Rank
  round                             Int       @default(1) // 1, 2, or 3
  year                              Int       @default(2024)

  capCourseId                       String
  capCourse                         CapCourse @relation(fields: [capCourseId], references: [id], onDelete: Cascade)

  createdAt                         DateTime  @default(now())

  @@index([category])
  @@index([capCourseId])
  @@index([round])
}

model CapPreferenceList {
  id             String    @id @default(cuid())
  title          String    @default("My MHT-CET CAP Preference List")
  candidateName  String
  applicationId  String?
  category       String    // e.g. "OPEN", "OBC", "SC", "ST", "EWS", "TFWS"
  percentile     Float
  rank           Int?
  homeUniversity String    @default("SPPU (Pune University)")
  round          String    @default("CAP Round 1")
  items          Json      // Array of preference choices with order, choiceCode, collegeName, courseName, cutoff, chance, notes
  
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

