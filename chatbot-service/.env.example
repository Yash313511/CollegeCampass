# ─── LLM Provider ─────────────────────────────────────────────────
# Supported: google | openai | ollama
LLM_PROVIDER=google
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-2.0-flash

# ─── Embedding (for future RAG) ──────────────────────────────────
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004

# ─── Service Authentication ──────────────────────────────────────
# Must match CHATBOT_SERVICE_TOKEN in the Next.js .env
SERVICE_TOKEN=change-me-to-a-random-secret

# ─── Server ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ─── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20
